<Application x:Class="Tetris.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Tetris"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
         <SolidColorBrush x:Key="BackgroundColor" Color="#211E2B"/>
         <SolidColorBrush x:Key="GridBackgroundColor" Color="#312C40"/>
         <SolidColorBrush x:Key="GridLineColor" Color="#4F4867"/>
         <SolidColorBrush x:Key="TextColor" Color="#EBEBEB"/>
         <SolidColorBrush x:Key="OverlayColor" Color="#7F000000"/>
         <FontFamily x:Key="MainFont">Assets/#Droid Sans Mono</FontFamily>
    </Application.Resources>
</Application>
